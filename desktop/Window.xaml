<Window x:Class="AtlasNext.WorkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ATLAS Next" Width="980" Height="690" MinWidth="650" MinHeight="480" Background="#F4F5F2" FontFamily="Segoe UI" FontSize="15" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#15342F" Padding="24,16"><DockPanel><Button x:Name="EmergencyStop" DockPanel.Dock="Right" Margin="18,0,0,0" Content="Stop all tasks" Click="StopAllTasks"/><TextBlock DockPanel.Dock="Right" Text="LOCAL  /  CPU" Foreground="#C1DDCA" VerticalAlignment="Center"/><TextBlock Text="ATLAS Next" Foreground="White" FontSize="24" FontWeight="SemiBold"/></DockPanel></Border>
  <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="Task history" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox x:Name="History" AutomationProperties.Name="Task history" DisplayMemberPath="Request" SelectionChanged="SelectTask" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="5,0,12,12">
    <TextBlock x:Name="RecoveryInfo" Foreground="#85451F" AutomationProperties.LiveSetting="Polite"/>
    <WrapPanel Margin="0,0,0,8"><TextBlock x:Name="ProjectLabel" Text="Active project: default" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ProjectName" Text="default" AutomationProperties.Name="Project name" Width="130" MaxLength="32"/><Button x:Name="SwitchProject" Content="Open project" Click="ChangeProject"/></WrapPanel>
    <TextBlock Text="Search project knowledge" FontSize="28" FontWeight="SemiBold" Foreground="#163D35"/>
    <TextBlock Margin="0,4,0,12" Foreground="#425C52" Text="Try “Where is Reader.Parse(int) defined?” or “Where is Reader.Parse(int) called?” for imported C# files. For local documents try “Compare project claims: output mode | retention window”. Select a completed comparison and ask “Recheck these claims.” Select a completed definition for parameters, return type, callers, signature or documentation follow-ups."/>
    <TextBox x:Name="Prompt" AutomationProperties.Name="Request" MaxLength="2048" Padding="10" TextWrapping="Wrap" Text="What is the archive retention policy?"/>
    <WrapPanel Margin="0,10,0,20"><Button x:Name="Search" Content="Find evidence" Click="Submit" IsDefault="True"/><Button x:Name="Import" Content="Import project file" Click="ImportFile"/><Button x:Name="Stop" Content="Stop task" Click="CancelTask" IsEnabled="False"/></WrapPanel>
    <Border Background="White" BorderBrush="#CBD6CE" BorderThickness="1" Padding="16" CornerRadius="5"><StackPanel>
     <TextBlock x:Name="Status" FontSize="18" FontWeight="SemiBold" Text="Ready"/>
     <TextBlock x:Name="Summary" Margin="0,8,0,0" Text="A matching record can be reviewed and verified before delivery."/>
     <TextBlock x:Name="ChecksInfo" Margin="0,8,0,0"/>
     <TextBlock x:Name="SourceInfo" Foreground="#486056" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <WrapPanel Margin="0,12,0,16"><Button x:Name="Verify" Content="Verify and finish" IsEnabled="False" Click="FinishTask"/><Button x:Name="Export" Content="Export receipt" IsEnabled="False" Click="ExportTask"/></WrapPanel>
    <TextBlock x:Name="ResearchInfo" Margin="0,4,0,10"/>
    <TextBlock Text="Primary routing" FontWeight="SemiBold"/><TextBlock x:Name="RoutingInfo" Margin="0,5,0,5" Foreground="#354C41" Text="Submit a request to compare the original model with the active rule."/>
    <TextBlock x:Name="Notice" Foreground="#85451F" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
