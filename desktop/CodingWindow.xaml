<Window x:Class="AtlasNext.CodingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ATLAS Next Coding Evidence" Width="800" Height="620" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <TextBlock x:Name="GuideTitle" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Verified source. Review or copy the exact signature and locations." TextWrapping="Wrap" Margin="0,6"/>
   <Button x:Name="ReferenceDraft" Content="Open local coding draft" Click="Draft" HorizontalAlignment="Left" Padding="8,5"/>
   <TextBlock x:Name="GuideStatus" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBox x:Name="GuideContent" AutomationProperties.Name="Verified coding evidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
 </DockPanel>
</Window>
